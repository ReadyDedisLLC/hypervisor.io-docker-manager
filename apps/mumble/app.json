{
  "name": "Mumble",
  "slug": "mumble",
  "description": "Low-latency, high-quality voice chat server for gaming and team communication.",
  "icon": "icon.png",
  "category": "communication",
  "version": "latest",
  "website": "https://mumble.info",
  "docs_url": "https://wiki.mumble.info/wiki/Main_Page",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "MUMBLE_SUPERUSER_PASSWORD",
      "label": "Superuser Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Mumble superuser account"
    },
    {
      "key": "MUMBLE_CONFIG_WELCOMETEXT",
      "label": "Welcome Text",
      "default": "Welcome to this Mumble server!",
      "required": false,
      "type": "text",
      "description": "Message displayed to users when they connect"
    },
    {
      "key": "MUMBLE_CONFIG_SERVERPASSWORD",
      "label": "Server Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password required to connect to the server (leave empty for no password)"
    },
    {
      "key": "MUMBLE_CONFIG_USERS",
      "label": "Max Users",
      "default": "100",
      "required": false,
      "type": "number",
      "description": "Maximum number of concurrent users"
    },
    {
      "key": "MUMBLE_CONFIG_BANDWIDTH",
      "label": "Max Bandwidth",
      "default": "72000",
      "required": false,
      "type": "number",
      "description": "Maximum bandwidth per client in bits per second"
    },
    {
      "key": "MUMBLE_CONFIG_REGISTERNAME",
      "label": "Server Name",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Server name shown in the public server list and client"
    }
  ],
  "ports": [
    {
      "container_port": 64738,
      "default_host_port": 64738,
      "protocol": "tcp",
      "label": "Voice (TCP)",
      "configurable": true
    },
    {
      "container_port": 64738,
      "default_host_port": 64738,
      "protocol": "udp",
      "label": "Voice (UDP)",
      "configurable": true
    }
  ]
}
