{
  "name": "File Browser",
  "slug": "filebrowser",
  "description": "Web-based file manager with upload, download, move, rename, and share capabilities in a clean interface.",
  "icon": "icon.png",
  "category": "file-storage",
  "version": "latest",
  "website": "https://filebrowser.org",
  "docs_url": "https://filebrowser.org/configuration",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-11","debian-12","rocky-9","almalinux-9","centos-stream-9"],
  "min_ram_mb": 64,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "FB_USERNAME",
      "label": "Admin Username",
      "default": "admin",
      "required": false,
      "type": "text",
      "description": "Default administrator username"
    },
    {
      "key": "FB_PASSWORD",
      "label": "Admin Password",
      "default": "admin",
      "required": false,
      "type": "password",
      "description": "Default administrator password"
    },
    {
      "key": "FB_ROOT",
      "label": "Root Directory",
      "default": "/srv",
      "required": false,
      "type": "text",
      "description": "Root directory to browse files from"
    },
    {
      "key": "FB_DATABASE",
      "label": "Database Path",
      "default": "/database/filebrowser.db",
      "required": false,
      "type": "text",
      "description": "Path to the File Browser database file (stored on the persistent database volume)"
    },
    {
      "key": "FB_NOAUTH",
      "label": "Disable Authentication",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "No", "value": "false" },
        { "label": "Yes", "value": "true" }
      ],
      "description": "Disable authentication (not recommended for production)"
    }
  ],
  "ports": [{"container_port":80,"default_host_port":8080,"protocol":"tcp","label":"Web UI","configurable":true}]
}
