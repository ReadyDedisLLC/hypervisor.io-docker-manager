{
  "name": "Jellyseerr",
  "slug": "jellyseerr",
  "description": "Media request and discovery manager for Jellyfin, allowing users to request movies and TV shows.",
  "icon": "icon.png",
  "category": "media",
  "version": "latest",
  "website": "https://github.com/Fallenbagel/jellyseerr",
  "docs_url": "https://docs.overseerr.dev/",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 512,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "LOG_LEVEL",
      "label": "Log Level",
      "default": "debug",
      "required": false,
      "type": "select",
      "options": ["debug", "info", "warn", "error"],
      "description": "Logging verbosity level"
    },
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "Etc/UTC",
      "required": false,
      "type": "text",
      "description": "Container timezone (e.g. America/New_York)"
    }
  ],
  "ports": [
    {
      "container_port": 5055,
      "default_host_port": 5055,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
