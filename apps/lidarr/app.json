{
  "name": "Lidarr",
  "slug": "lidarr",
  "description": "Music collection manager that monitors RSS feeds and integrates with download clients to grab, sort, and rename music.",
  "icon": "icon.png",
  "category": "media",
  "version": "latest",
  "website": "https://lidarr.audio",
  "docs_url": "https://wiki.servarr.com/lidarr",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 512,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "PUID",
      "label": "User ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID for file permissions"
    },
    {
      "key": "PGID",
      "label": "Group ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID for file permissions"
    },
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "Etc/UTC",
      "required": false,
      "type": "text",
      "description": "Timezone for the container (e.g. America/New_York)"
    },
    {
      "key": "UMASK",
      "label": "Umask",
      "default": "022",
      "required": false,
      "type": "text",
      "description": "Umask setting for newly created files"
    }
  ],
  "ports": [
    {
      "container_port": 8686,
      "default_host_port": 8686,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
