{
  "name": "Nextcloud",
  "slug": "nextcloud",
  "description": "Self-hosted productivity and file storage platform — a complete alternative to Google Drive, Calendar, and Contacts.",
  "icon": "icon.png",
  "category": "file-storage",
  "version": "latest",
  "website": "https://nextcloud.com",
  "docs_url": "https://docs.nextcloud.com/server/latest/admin_manual/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 20,
  "env": [
    {
      "key": "MYSQL_ROOT_PASSWORD",
      "label": "MySQL Root Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Root password for the MariaDB database"
    },
    {
      "key": "MYSQL_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Nextcloud database user"
    },
    {
      "key": "MYSQL_DATABASE",
      "label": "Database Name",
      "default": "nextcloud",
      "required": true,
      "type": "text",
      "description": "Name of the Nextcloud database"
    },
    {
      "key": "MYSQL_USER",
      "label": "Database User",
      "default": "nextcloud",
      "required": true,
      "type": "text",
      "description": "Database username for Nextcloud"
    },
    {
      "key": "NEXTCLOUD_ADMIN_USER",
      "label": "Admin Username",
      "default": "admin",
      "required": true,
      "type": "text",
      "description": "Username for the Nextcloud admin account"
    },
    {
      "key": "NEXTCLOUD_ADMIN_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Nextcloud admin account"
    },
    {
      "key": "NEXTCLOUD_TRUSTED_DOMAINS",
      "label": "Trusted Domains",
      "default": "localhost",
      "required": false,
      "type": "text",
      "description": "Space-separated list of trusted domains for Nextcloud access"
    },
    {
      "key": "SMTP_HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails"
    },
    {
      "key": "SMTP_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port (typically 587 for TLS or 465 for SSL)"
    },
    {
      "key": "SMTP_NAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "SMTP_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "MAIL_FROM_ADDRESS",
      "label": "Mail From Address",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Local part of the from address (e.g. 'nextcloud' for nextcloud@example.com)"
    },
    {
      "key": "MAIL_DOMAIN",
      "label": "Mail Domain",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Domain part of the from address (e.g. 'example.com')"
    }
  ],
  "ports": [
    {
      "container_port": 80,
      "default_host_port": 8080,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
