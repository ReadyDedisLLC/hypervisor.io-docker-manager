{
  "name": "Mattermost",
  "slug": "mattermost",
  "description": "Open-source team messaging platform — a self-hosted alternative to Slack with channels, threads, and integrations.",
  "icon": "icon.png",
  "category": "communication",
  "version": "latest",
  "website": "https://mattermost.com",
  "docs_url": "https://docs.mattermost.com",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "MM_SQLSETTINGS_DATASOURCE_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Mattermost PostgreSQL database"
    },
    {
      "key": "MM_SERVICESETTINGS_SITEURL",
      "label": "Site URL",
      "default": "http://localhost:8065",
      "required": false,
      "type": "text",
      "description": "Full URL of the Mattermost server (e.g. https://mattermost.example.com)"
    },
    {
      "key": "MM_PLUGINSETTINGS_ENABLEUPLOADS",
      "label": "Enable Plugin Uploads",
      "default": "true",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Allow uploading custom plugins via the admin console"
    },
    {
      "key": "MM_TEAMSETTINGS_MAXUSERSPERTEAM",
      "label": "Max Users Per Team",
      "default": "50",
      "required": false,
      "type": "number",
      "description": "Maximum number of users allowed per team"
    },
    {
      "key": "MM_FILESETTINGS_MAXFILESIZE",
      "label": "Max File Size",
      "default": "52428800",
      "required": false,
      "type": "number",
      "description": "Maximum file attachment size in bytes (default 50MB)"
    },
    {
      "key": "MM_EMAILSETTINGS_SMTPSERVER",
      "label": "SMTP Server",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for email notifications"
    },
    {
      "key": "MM_EMAILSETTINGS_SMTPPORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port for email notifications"
    },
    {
      "key": "MM_EMAILSETTINGS_SMTPUSERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "MM_EMAILSETTINGS_SMTPPASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    }
  ],
  "ports": [
    {
      "container_port": 8065,
      "default_host_port": 8065,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
