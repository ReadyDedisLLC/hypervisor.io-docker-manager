{
  "name": "Traefik",
  "slug": "traefik",
  "description": "Cloud-native reverse proxy and load balancer with automatic HTTPS, Docker integration, and a real-time dashboard.",
  "icon": "icon.png",
  "category": "networking",
  "version": "v3.0",
  "website": "https://traefik.io",
  "docs_url": "https://doc.traefik.io/traefik/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 128,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL",
      "label": "Let's Encrypt Email",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Email address for Let's Encrypt certificate registration and notifications"
    },
    {
      "key": "TRAEFIK_API_DASHBOARD",
      "label": "Enable Dashboard",
      "default": "true",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Enable or disable the Traefik web dashboard"
    },
    {
      "key": "TRAEFIK_LOG_LEVEL",
      "label": "Log Level",
      "default": "ERROR",
      "required": false,
      "type": "select",
      "options": [
        { "label": "DEBUG", "value": "DEBUG" },
        { "label": "INFO", "value": "INFO" },
        { "label": "WARN", "value": "WARN" },
        { "label": "ERROR", "value": "ERROR" }
      ],
      "description": "Logging level for Traefik"
    }
  ],
  "ports": [
    {
      "container_port": 80,
      "default_host_port": 80,
      "protocol": "tcp",
      "label": "HTTP",
      "configurable": false
    },
    {
      "container_port": 443,
      "default_host_port": 443,
      "protocol": "tcp",
      "label": "HTTPS",
      "configurable": false
    },
    {
      "container_port": 8080,
      "default_host_port": 8080,
      "protocol": "tcp",
      "label": "Dashboard",
      "configurable": true
    }
  ]
}
