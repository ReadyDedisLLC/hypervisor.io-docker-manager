{
  "name": "Paperless-ngx",
  "slug": "paperless-ngx",
  "description": "Document management system that transforms physical documents into a searchable digital archive with OCR.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://docs.paperless-ngx.com",
  "docs_url": "https://docs.paperless-ngx.com/configuration/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "PAPERLESS_SECRET_KEY",
      "label": "Secret Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for Django session management"
    },
    {
      "key": "PAPERLESS_ADMIN_USER",
      "label": "Admin Username",
      "default": "admin",
      "required": true,
      "type": "text",
      "description": "Initial admin username"
    },
    {
      "key": "PAPERLESS_ADMIN_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Initial admin password"
    },
    {
      "key": "PAPERLESS_DB_PASS",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Paperless PostgreSQL database"
    },
    {
      "key": "PAPERLESS_URL",
      "label": "Application URL",
      "default": "http://localhost:8000",
      "required": false,
      "type": "text",
      "description": "Public URL of your Paperless-ngx instance (used for links in emails)"
    },
    {
      "key": "PAPERLESS_TIME_ZONE",
      "label": "Timezone",
      "default": "America/New_York",
      "required": false,
      "type": "text",
      "description": "Timezone for the application (e.g. America/New_York, Europe/London)"
    },
    {
      "key": "PAPERLESS_OCR_LANGUAGE",
      "label": "OCR Language",
      "default": "eng",
      "required": false,
      "type": "text",
      "description": "OCR language (e.g. eng, deu, fra). Install additional packages for more languages."
    },
    {
      "key": "PAPERLESS_FILENAME_FORMAT",
      "label": "Filename Format",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Template for naming stored files (e.g. {created_year}/{correspondent}/{title})"
    },
    {
      "key": "PAPERLESS_CONSUMER_POLLING",
      "label": "Consumer Polling Interval",
      "default": "0",
      "required": false,
      "type": "number",
      "description": "Polling interval in seconds for new files in the consume folder (0 uses inotify)"
    }
  ],
  "ports": [
    {
      "container_port": 8000,
      "default_host_port": 8000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
