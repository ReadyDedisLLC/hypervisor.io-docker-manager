{
  "name": "Typesense",
  "slug": "typesense",
  "description": "Fast, typo-tolerant search engine optimized for instant search-as-you-type experiences.",
  "icon": "icon.png",
  "category": "databases",
  "version": "latest",
  "website": "https://typesense.org",
  "docs_url": "https://typesense.org/docs/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "TYPESENSE_API_KEY",
      "label": "API Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "API key for authenticating requests to Typesense"
    },
    {
      "key": "TYPESENSE_ENABLE_CORS",
      "label": "Enable CORS",
      "default": "true",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Enable cross-origin resource sharing for browser-based search"
    }
  ],
  "ports": [
    {
      "container_port": 8108,
      "default_host_port": 8108,
      "protocol": "tcp",
      "label": "API",
      "configurable": true
    }
  ]
}
