{
  "name": "Authentik",
  "slug": "authentik",
  "description": "Open-source identity provider with support for OAuth2, SAML, LDAP, and SCIM for single sign-on and user management.",
  "icon": "icon.png",
  "category": "security",
  "version": "latest",
  "website": "https://goauthentik.io",
  "docs_url": "https://docs.goauthentik.io/docs/install-config/install/docker-compose",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 2048,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "AUTHENTIK_SECRET_KEY",
      "label": "Secret Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key used for signing and encryption"
    },
    {
      "key": "PG_PASS",
      "label": "PostgreSQL Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "AUTHENTIK_BOOTSTRAP_PASSWORD",
      "label": "Initial Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Initial password for the admin account"
    },
    {
      "key": "AUTHENTIK_BOOTSTRAP_EMAIL",
      "label": "Admin Email",
      "default": "admin@example.com",
      "required": true,
      "type": "text",
      "description": "Email address for the admin account"
    },
    {
      "key": "AUTHENTIK_BOOTSTRAP_TOKEN",
      "label": "Bootstrap API Token",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "API token created on first startup for the admin user"
    },
    {
      "key": "AUTHENTIK_ERROR_REPORTING__ENABLED",
      "label": "Error Reporting",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Enabled", "value": "true" },
        { "label": "Disabled", "value": "false" }
      ],
      "description": "Enable or disable anonymous error reporting to Authentik"
    },
    {
      "key": "AUTHENTIK_LOG_LEVEL",
      "label": "Log Level",
      "default": "info",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Trace", "value": "trace" },
        { "label": "Debug", "value": "debug" },
        { "label": "Info", "value": "info" },
        { "label": "Warning", "value": "warning" },
        { "label": "Error", "value": "error" }
      ],
      "description": "Logging verbosity level"
    },
    {
      "key": "AUTHENTIK_EMAIL__HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails"
    },
    {
      "key": "AUTHENTIK_EMAIL__PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port"
    },
    {
      "key": "AUTHENTIK_EMAIL__USERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "AUTHENTIK_EMAIL__PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "AUTHENTIK_EMAIL__FROM",
      "label": "Email From Address",
      "default": "",
      "required": false,
      "type": "text",
      "description": "From address for outgoing emails (e.g. authentik@example.com)"
    },
    {
      "key": "AUTHENTIK_EMAIL__USE_TLS",
      "label": "SMTP Use TLS",
      "default": "true",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Enable TLS for SMTP connection"
    }
  ],
  "ports": [
    {
      "container_port": 9000,
      "default_host_port": 9001,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    },
    {
      "container_port": 9443,
      "default_host_port": 9443,
      "protocol": "tcp",
      "label": "HTTPS",
      "configurable": true
    }
  ]
}
