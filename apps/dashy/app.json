{
  "name": "Dashy",
  "slug": "dashy",
  "description": "Highly customizable, self-hosted dashboard application for organizing and accessing your services and bookmarks.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://dashy.to",
  "docs_url": "https://dashy.to/docs",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "NODE_ENV",
      "label": "Node Environment",
      "default": "production",
      "required": false,
      "type": "select",
      "options": ["production", "development"],
      "description": "Set the Node.js environment mode"
    },
    {
      "key": "GH_ACCESS_TOKEN",
      "label": "GitHub Access Token",
      "default": "",
      "required": false,
      "type": "password",
      "description": "GitHub token for backing up config to a gist"
    },
    {
      "key": "VUE_APP_DOMAIN",
      "label": "App Domain",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Domain where Dashy is served (used for authentication)"
    }
  ],
  "ports": [
    {
      "container_port": 8080,
      "default_host_port": 8099,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
