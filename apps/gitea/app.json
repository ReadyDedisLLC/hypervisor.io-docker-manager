{
  "name": "Gitea",
  "slug": "gitea",
  "description": "Lightweight self-hosted Git service providing repository hosting, code review, and CI/CD pipelines.",
  "icon": "icon.png",
  "category": "development",
  "version": "latest",
  "website": "https://gitea.io",
  "docs_url": "https://docs.gitea.com/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "GITEA__server__ROOT_URL",
      "label": "Root URL",
      "default": "http://localhost:3000",
      "required": true,
      "type": "text",
      "description": "Public URL used to access Gitea (e.g. https://git.example.com)"
    },
    {
      "key": "GITEA__server__DOMAIN",
      "label": "Server Domain",
      "default": "localhost",
      "required": false,
      "type": "text",
      "description": "Domain name of the Gitea server"
    },
    {
      "key": "GITEA__database__DB_TYPE",
      "label": "Database Type",
      "default": "sqlite3",
      "required": false,
      "type": "select",
      "options": ["sqlite3", "mysql", "postgres"],
      "description": "Database engine to use"
    },
    {
      "key": "GITEA__mailer__ENABLED",
      "label": "Enable Mailer",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Enable email notifications"
    },
    {
      "key": "GITEA__service__DISABLE_REGISTRATION",
      "label": "Disable Registration",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Disable self-registration of new users"
    },
    {
      "key": "GITEA__security__SECRET_KEY",
      "label": "Secret Key",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "Global secret key used to encrypt sensitive data; keep stable across reinstalls"
    },
    {
      "key": "GITEA__security__INTERNAL_TOKEN",
      "label": "Internal Token",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "Token used to validate internal API communication"
    },
    {
      "key": "USER_UID",
      "label": "User UID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID of the Gitea user inside the container"
    },
    {
      "key": "USER_GID",
      "label": "User GID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID of the Gitea user inside the container"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    },
    {
      "container_port": 22,
      "default_host_port": 2222,
      "protocol": "tcp",
      "label": "SSH",
      "configurable": true
    }
  ]
}
