{
  "name": "Nginx Proxy Manager",
  "slug": "nginx-proxy-manager",
  "description": "Easy-to-use reverse proxy with a web UI for managing SSL certificates, proxy hosts, and access lists.",
  "icon": "icon.png",
  "category": "networking",
  "version": "latest",
  "website": "https://nginxproxymanager.com",
  "docs_url": "https://nginxproxymanager.com/guide/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "DISABLE_IPV6",
      "label": "Disable IPv6",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Set to true to disable IPv6 in Nginx if your environment does not support it"
    },
    {
      "key": "X_FRAME_OPTIONS",
      "label": "X-Frame-Options",
      "default": "deny",
      "required": false,
      "type": "text",
      "description": "X-Frame-Options header value for the admin interface (e.g. deny, sameorigin)"
    }
  ],
  "ports": [
    {
      "container_port": 80,
      "default_host_port": 80,
      "protocol": "tcp",
      "label": "HTTP",
      "configurable": false
    },
    {
      "container_port": 443,
      "default_host_port": 443,
      "protocol": "tcp",
      "label": "HTTPS",
      "configurable": false
    },
    {
      "container_port": 81,
      "default_host_port": 81,
      "protocol": "tcp",
      "label": "Admin UI",
      "configurable": true
    }
  ]
}
