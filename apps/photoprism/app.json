{
  "name": "PhotoPrism",
  "slug": "photoprism",
  "description": "AI-powered photo management app with automatic face recognition, object detection, and location tagging.",
  "icon": "icon.png",
  "category": "media",
  "version": "latest",
  "website": "https://www.photoprism.app",
  "docs_url": "https://docs.photoprism.app/getting-started/",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 2048,
  "min_storage_gb": 20,
  "env": [
    {"key":"PHOTOPRISM_ADMIN_PASSWORD","label":"Admin Password","default":"","required":true,"type":"password","generate":true,"description":"Initial admin account password"},
    {"key":"PHOTOPRISM_SITE_URL","label":"Site URL","default":"http://localhost:2342/","required":true,"type":"text","description":"Public URL of your PhotoPrism instance"},
    {"key":"PHOTOPRISM_DB_PASSWORD","label":"Database Password","default":"","required":true,"type":"password","generate":true,"description":"Password for PhotoPrism MariaDB database"},
    {
      "key": "PHOTOPRISM_SITE_TITLE",
      "label": "Site Title",
      "default": "PhotoPrism",
      "required": false,
      "type": "text",
      "description": "Title displayed in the browser tab and header"
    },
    {
      "key": "PHOTOPRISM_UPLOAD_NSFW",
      "label": "Allow NSFW Uploads",
      "default": "true",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Allow uploading photos that may be offensive"
    },
    {
      "key": "PHOTOPRISM_EXPERIMENTAL",
      "label": "Experimental Features",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Enable experimental features"
    },
    {
      "key": "PHOTOPRISM_ORIGINALS_LIMIT",
      "label": "Upload Size Limit (MB)",
      "default": "5000",
      "required": false,
      "type": "number",
      "description": "Maximum file size in MB for originals (default 5000 MB)"
    },
    {
      "key": "PHOTOPRISM_DISABLE_TENSORFLOW",
      "label": "Disable TensorFlow",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Disable TensorFlow-based image classification and face detection"
    }
  ],
  "ports": [{"container_port":2342,"default_host_port":2342,"protocol":"tcp","label":"Web UI","configurable":true}]
}
