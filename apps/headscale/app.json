{
  "name": "Headscale",
  "slug": "headscale",
  "description": "Self-hosted open-source implementation of the Tailscale control server for managing a WireGuard-based VPN.",
  "icon": "icon.png",
  "category": "networking",
  "version": "latest",
  "website": "https://headscale.net",
  "docs_url": "https://headscale.net/stable/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "HEADSCALE_SERVER_URL",
      "label": "Server URL",
      "default": "http://localhost:8093",
      "required": true,
      "type": "text",
      "description": "Public URL of the Headscale server"
    },
    {
      "key": "HEADSCALE_LISTEN_ADDR",
      "label": "Listen Address",
      "default": "0.0.0.0:8080",
      "required": false,
      "type": "text",
      "description": "Address and port the Headscale server listens on"
    },
    {
      "key": "HEADSCALE_METRICS_LISTEN_ADDR",
      "label": "Metrics Listen Address",
      "default": "0.0.0.0:9090",
      "required": false,
      "type": "text",
      "description": "Address and port for the Prometheus metrics endpoint"
    },
    {
      "key": "HEADSCALE_DERP_SERVER_ENABLED",
      "label": "Enable DERP Server",
      "default": "true",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Enable the built-in DERP relay server"
    },
    {
      "key": "HEADSCALE_DNS_BASE_DOMAIN",
      "label": "DNS Base Domain",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Base domain for MagicDNS (e.g. example.com)"
    },
    {
      "key": "HEADSCALE_PREFIXES_V4",
      "label": "IPv4 Prefix",
      "default": "100.64.0.0/10",
      "required": false,
      "type": "text",
      "description": "IPv4 prefix for the Tailnet address space"
    }
  ],
  "ports": [
    {
      "container_port": 8080,
      "default_host_port": 8093,
      "protocol": "tcp",
      "label": "Web UI/API",
      "configurable": true
    },
    {
      "container_port": 3478,
      "default_host_port": 3478,
      "protocol": "udp",
      "label": "DERP/STUN",
      "configurable": true
    }
  ]
}
