{
  "name": "Flowise",
  "slug": "flowise",
  "description": "Drag and drop LLM flow builder for creating customized AI workflows and chatbots with no code.",
  "icon": "icon.png",
  "category": "ai",
  "version": "latest",
  "website": "https://flowiseai.com",
  "docs_url": "https://docs.flowiseai.com",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "FLOWISE_USERNAME",
      "label": "Username",
      "default": "admin",
      "required": true,
      "type": "text",
      "description": "Username for Flowise web interface login"
    },
    {
      "key": "FLOWISE_PASSWORD",
      "label": "Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for Flowise web interface login"
    },
    {
      "key": "FLOWISE_SECRETKEY_OVERWRITE",
      "label": "Encryption Secret Key",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "Secret key used to encrypt credentials stored in the database"
    },
    {
      "key": "DATABASE_TYPE",
      "label": "Database Type",
      "default": "sqlite",
      "required": false,
      "type": "select",
      "options": ["sqlite", "mysql", "postgres"],
      "description": "Database backend to use for Flowise data storage"
    },
    {
      "key": "LOG_LEVEL",
      "label": "Log Level",
      "default": "info",
      "required": false,
      "type": "select",
      "options": ["debug", "info", "warn", "error"],
      "description": "Application log verbosity level"
    },
    {
      "key": "APIKEY_PATH",
      "label": "API Key Storage Path",
      "default": "/root/.flowise",
      "required": false,
      "type": "text",
      "description": "Path where API keys are stored"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
