{
  "name": "DocuSeal",
  "slug": "docuseal",
  "description": "Self-hosted document signing platform for creating, filling, and signing digital documents with ease.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://docuseal.co",
  "docs_url": "https://www.docuseal.co/docs",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "SECRET_KEY_BASE",
      "label": "Secret Key Base",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for session encryption and signed cookies"
    },
    {
      "key": "DATABASE_URL",
      "label": "Database URL",
      "default": "",
      "required": false,
      "type": "text",
      "description": "PostgreSQL connection URL (leave empty to use built-in SQLite)"
    },
    {
      "key": "SMTP_ADDRESS",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails"
    },
    {
      "key": "SMTP_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port"
    },
    {
      "key": "SMTP_USERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "SMTP_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "SMTP_FROM",
      "label": "SMTP From Address",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Email address used as the sender (e.g., noreply@example.com)"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3003,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
