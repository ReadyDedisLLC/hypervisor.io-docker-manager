{
  "name": "WordPress",
  "slug": "wordpress",
  "description": "The world's most popular content management system, powering over 40% of all websites on the internet.",
  "icon": "icon.png",
  "category": "cms",
  "version": "latest",
  "website": "https://wordpress.org",
  "docs_url": "https://developer.wordpress.org/advanced-administration/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "MYSQL_ROOT_PASSWORD",
      "label": "MySQL Root Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Root password for the MySQL database"
    },
    {
      "key": "MYSQL_DATABASE",
      "label": "Database Name",
      "default": "wordpress",
      "required": true,
      "type": "text",
      "description": "Name of the WordPress database"
    },
    {
      "key": "MYSQL_USER",
      "label": "Database User",
      "default": "wordpress",
      "required": true,
      "type": "text",
      "description": "MySQL user for WordPress"
    },
    {
      "key": "MYSQL_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the WordPress database user"
    },
    {
      "key": "WORDPRESS_TABLE_PREFIX",
      "label": "Table Prefix",
      "default": "wp_",
      "required": false,
      "type": "text",
      "description": "Database table prefix (change for multiple WordPress installs on one database)"
    },
    {
      "key": "WORDPRESS_DEBUG",
      "label": "Debug Mode",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Off", "value": "false" },
        { "label": "On", "value": "true" }
      ],
      "description": "Enable WordPress debug mode for development and troubleshooting"
    },
    {
      "key": "WORDPRESS_CONFIG_EXTRA",
      "label": "Extra wp-config.php",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Additional PHP code to append to wp-config.php (e.g., define('WP_MEMORY_LIMIT', '256M');)"
    }
  ],
  "ports": [
    {
      "container_port": 80,
      "default_host_port": 8080,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
