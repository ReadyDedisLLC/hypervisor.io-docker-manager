{
  "name": "Satisfactory Server",
  "slug": "satisfactory",
  "description": "Dedicated server for Satisfactory, the factory-building game by Coffee Stain Studios.",
  "icon": "icon.png",
  "category": "gaming",
  "version": "latest",
  "website": "https://satisfactory.wiki.gg",
  "docs_url": "https://github.com/wolveix/satisfactory-server/wiki",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 8192,
  "min_storage_gb": 25,
  "env": [
    {
      "key": "MAXPLAYERS",
      "label": "Max Players",
      "default": "4",
      "required": true,
      "type": "number",
      "description": "Maximum number of players allowed on the server"
    },
    {
      "key": "SERVERGAMEPORT",
      "label": "Game Port",
      "default": "7777",
      "required": true,
      "type": "number",
      "description": "UDP port for game traffic"
    },
    {
      "key": "AUTOPAUSE",
      "label": "Auto Pause",
      "default": "true",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Automatically pause the server when no players are connected"
    },
    {
      "key": "AUTOSAVEINTERVAL",
      "label": "Auto-Save Interval",
      "default": "300",
      "required": false,
      "type": "number",
      "description": "Auto-save interval in seconds (default: 300)"
    },
    {
      "key": "CRASHREPORT",
      "label": "Crash Reporting",
      "default": "true",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Enable automatic crash reporting"
    },
    {
      "key": "PGID",
      "label": "Group ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID for file permissions"
    },
    {
      "key": "PUID",
      "label": "User ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID for file permissions"
    },
    {
      "key": "STEAMBETA",
      "label": "Steam Beta Branch",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Set to true to use the experimental branch of the server"
    }
  ],
  "ports": [
    {
      "container_port": 7777,
      "default_host_port": 7777,
      "protocol": "udp",
      "label": "Game",
      "configurable": true
    },
    {
      "container_port": 15000,
      "default_host_port": 15000,
      "protocol": "udp",
      "label": "Beacon",
      "configurable": true
    },
    {
      "container_port": 15777,
      "default_host_port": 15777,
      "protocol": "udp",
      "label": "Query",
      "configurable": true
    }
  ]
}
