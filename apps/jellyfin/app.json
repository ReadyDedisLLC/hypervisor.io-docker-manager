{
  "name": "Jellyfin",
  "slug": "jellyfin",
  "description": "Free and open-source media server for streaming movies, TV shows, music, and photos to any device.",
  "icon": "icon.png",
  "category": "media",
  "version": "latest",
  "website": "https://jellyfin.org",
  "docs_url": "https://jellyfin.org/docs/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 20,
  "env": [
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "Etc/UTC",
      "required": false,
      "type": "text",
      "description": "Container timezone (e.g. America/New_York)"
    },
    {
      "key": "JELLYFIN_PublishedServerUrl",
      "label": "Published Server URL",
      "default": "",
      "required": false,
      "type": "text",
      "description": "The public URL of your Jellyfin server, used for DLNA and client discovery (e.g. http://your-server-ip:8096)"
    }
  ],
  "ports": [
    {
      "container_port": 8096,
      "default_host_port": 8096,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
