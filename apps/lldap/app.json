{
  "name": "LLDAP",
  "slug": "lldap",
  "description": "Lightweight LDAP server with a simple web UI for managing users and groups across your self-hosted services.",
  "icon": "icon.png",
  "category": "security",
  "version": "stable",
  "website": "https://github.com/lldap/lldap",
  "docs_url": "https://github.com/lldap/lldap/blob/main/README.md",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-11","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 64,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "LLDAP_JWT_SECRET",
      "label": "JWT Secret",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for JWT authentication"
    },
    {
      "key": "LLDAP_LDAP_USER_PASS",
      "label": "Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the default admin user"
    },
    {
      "key": "LLDAP_KEY_SEED",
      "label": "Key Seed",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Seed used to derive the private key that encrypts stored passwords. Keep stable; changing it invalidates stored secrets."
    },
    {
      "key": "LLDAP_LDAP_BASE_DN",
      "label": "Base DN",
      "default": "dc=example,dc=com",
      "required": true,
      "type": "text",
      "description": "LDAP base distinguished name"
    },
    {
      "key": "LLDAP_LDAP_USER_DN",
      "label": "Admin Username",
      "default": "admin",
      "required": false,
      "type": "text",
      "description": "Username for the LDAP admin account"
    },
    {
      "key": "LLDAP_LDAP_USER_EMAIL",
      "label": "Admin Email",
      "default": "admin@example.com",
      "required": false,
      "type": "text",
      "description": "Email address for the admin user"
    },
    {
      "key": "LLDAP_DATABASE_URL",
      "label": "Database URL",
      "default": "sqlite:///data/users.db?mode=rwc",
      "required": false,
      "type": "text",
      "description": "Database connection URL (sqlite, mysql, or postgres)"
    },
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "Etc/UTC",
      "required": false,
      "type": "text",
      "description": "Timezone for the container (e.g. America/New_York)"
    },
    {
      "key": "UID",
      "label": "User ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID for the container process"
    },
    {
      "key": "GID",
      "label": "Group ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID for the container process"
    }
  ],
  "ports": [
    {"container_port":17170,"default_host_port":17170,"protocol":"tcp","label":"Web UI","configurable":true},
    {"container_port":3890,"default_host_port":3890,"protocol":"tcp","label":"LDAP","configurable":true}
  ]
}
