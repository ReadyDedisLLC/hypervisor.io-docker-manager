{
  "name": "Loki",
  "slug": "loki",
  "description": "Horizontally scalable, highly available log aggregation system inspired by Prometheus, designed for cost-effective log storage.",
  "icon": "icon.png",
  "category": "monitoring",
  "version": "latest",
  "website": "https://grafana.com/oss/loki/",
  "docs_url": "https://grafana.com/docs/loki/latest/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "LOKI_LOG_LEVEL",
      "label": "Log Level",
      "default": "info",
      "required": false,
      "type": "select",
      "options": ["debug", "info", "warn", "error"],
      "description": "Logging verbosity level for Loki"
    },
    {
      "key": "LOKI_AUTH_ENABLED",
      "label": "Enable Auth",
      "default": "false",
      "required": false,
      "type": "select",
      "options": ["true", "false"],
      "description": "Enable multi-tenancy authentication"
    },
    {
      "key": "LOKI_RETENTION_PERIOD",
      "label": "Retention Period",
      "default": "744h",
      "required": false,
      "type": "text",
      "description": "How long to retain log data (e.g. 744h for 31 days)"
    }
  ],
  "ports": [
    {
      "container_port": 3100,
      "default_host_port": 3100,
      "protocol": "tcp",
      "label": "API",
      "configurable": true
    }
  ]
}
