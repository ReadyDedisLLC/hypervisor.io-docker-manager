{
  "name": "Radarr",
  "slug": "radarr",
  "description": "Movie collection manager that automatically searches for movies, grabs releases, and organizes your library.",
  "icon": "icon.png",
  "category": "media",
  "version": "5",
  "website": "https://radarr.video",
  "docs_url": "https://wiki.servarr.com/radarr",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "PUID",
      "label": "User ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID for file permissions"
    },
    {
      "key": "PGID",
      "label": "Group ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID for file permissions"
    },
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "Etc/UTC",
      "required": false,
      "type": "text",
      "description": "Timezone in TZ database format (e.g. America/New_York)"
    }
  ],
  "ports": [
    {
      "container_port": 7878,
      "default_host_port": 7878,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
