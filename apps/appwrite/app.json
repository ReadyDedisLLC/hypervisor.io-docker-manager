{
  "name": "Appwrite",
  "slug": "appwrite",
  "description": "Open-source backend server for web and mobile apps with auth, database, storage, functions, and messaging.",
  "icon": "icon.png",
  "category": "development",
  "version": "latest",
  "website": "https://appwrite.io",
  "docs_url": "https://appwrite.io/docs/advanced/self-hosting",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 2048,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "_APP_OPENSSL_KEY_V1",
      "label": "Encryption Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for encrypting data at rest"
    },
    {
      "key": "_APP_DB_PASS",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for Appwrite MariaDB database"
    },
    {
      "key": "_APP_DOMAIN",
      "label": "Domain",
      "default": "localhost",
      "required": false,
      "type": "text",
      "description": "Public domain for the Appwrite instance (e.g. appwrite.example.com)"
    },
    {
      "key": "_APP_DOMAIN_TARGET",
      "label": "Domain Target",
      "default": "localhost",
      "required": false,
      "type": "text",
      "description": "CNAME target domain for custom domains"
    },
    {
      "key": "_APP_LOCALE",
      "label": "Locale",
      "default": "en",
      "required": false,
      "type": "text",
      "description": "Default locale for the Appwrite instance (e.g. en, fr, de)"
    },
    {
      "key": "_APP_CONSOLE_WHITELIST_ROOT",
      "label": "Restrict Console Signup",
      "default": "disabled",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Disabled (anyone can sign up)", "value": "disabled" },
        { "label": "Enabled (only first user)", "value": "enabled" }
      ],
      "description": "When enabled, only the first user can sign up for the console"
    },
    {
      "key": "_APP_SMTP_HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails"
    },
    {
      "key": "_APP_SMTP_PORT",
      "label": "SMTP Port",
      "default": "25",
      "required": false,
      "type": "number",
      "description": "SMTP server port (25, 465, or 587)"
    },
    {
      "key": "_APP_SMTP_USERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "_APP_SMTP_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "_APP_SMTP_SECURE",
      "label": "SMTP Encryption",
      "default": "",
      "required": false,
      "type": "select",
      "options": [
        { "label": "None", "value": "" },
        { "label": "TLS", "value": "tls" },
        { "label": "SSL", "value": "ssl" }
      ],
      "description": "SMTP connection encryption method"
    },
    {
      "key": "_APP_STORAGE_LIMIT",
      "label": "Storage Upload Limit (bytes)",
      "default": "30000000",
      "required": false,
      "type": "number",
      "description": "Maximum file upload size in bytes (default 30MB)"
    },
    {
      "key": "_APP_USAGE_STATS",
      "label": "Usage Statistics",
      "default": "enabled",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Enabled", "value": "enabled" },
        { "label": "Disabled", "value": "disabled" }
      ],
      "description": "Enable or disable collection of usage statistics"
    }
  ],
  "ports": [
    {"container_port":80,"default_host_port":8080,"protocol":"tcp","label":"Web UI","configurable":true},
    {"container_port":443,"default_host_port":8443,"protocol":"tcp","label":"HTTPS","configurable":true}
  ]
}
