{
  "name": "Stirling-PDF",
  "slug": "stirling-pdf",
  "description": "Powerful locally hosted PDF manipulation tool with splitting, merging, converting, OCR, and 30+ other operations.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://github.com/Stirling-Tools/Stirling-PDF",
  "docs_url": "https://stirlingpdf.io/docs",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "DOCKER_ENABLE_SECURITY",
      "label": "Enable Security",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Disabled", "value": "false" },
        { "label": "Enabled", "value": "true" }
      ],
      "description": "Enable login authentication for the web interface"
    },
    {
      "key": "SECURITY_INITIALLOGIN_USERNAME",
      "label": "Admin Username",
      "default": "admin",
      "required": false,
      "type": "text",
      "description": "Initial admin username (only used when security is enabled)"
    },
    {
      "key": "SECURITY_INITIALLOGIN_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "Initial admin password (only used when security is enabled)"
    },
    {
      "key": "LANGS",
      "label": "OCR Languages",
      "default": "en_GB",
      "required": false,
      "type": "text",
      "description": "OCR languages to install, comma-separated (e.g., en_GB,fr_FR,de_DE)"
    },
    {
      "key": "INSTALL_BOOK_AND_ADVANCED_HTML_OPS",
      "label": "Install Advanced Operations",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Disabled", "value": "false" },
        { "label": "Enabled", "value": "true" }
      ],
      "description": "Install calibre for ebook and advanced HTML conversion support"
    }
  ],
  "ports": [
    {
      "container_port": 8080,
      "default_host_port": 8080,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
