{
  "name": "Tandoor Recipes",
  "slug": "tandoor-recipes",
  "description": "Recipe manager and meal planner for organizing, sharing, and cooking your favorite recipes.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://tandoor.dev",
  "docs_url": "https://docs.tandoor.dev",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "SECRET_KEY",
      "label": "Secret Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Django secret key for application security"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "label": "PostgreSQL Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "ENABLE_SIGNUP",
      "label": "Enable Signup",
      "default": "0",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Disabled", "value": "0" },
        { "label": "Enabled", "value": "1" }
      ],
      "description": "Allow new users to register accounts"
    },
    {
      "key": "TANDOOR_PORT",
      "label": "Internal Port",
      "default": "8080",
      "required": false,
      "type": "number",
      "description": "Port the application listens on inside the container"
    },
    {
      "key": "FRACTION_PREF_DEFAULT",
      "label": "Default Fraction Display",
      "default": "0",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Decimals", "value": "0" },
        { "label": "Fractions", "value": "1" }
      ],
      "description": "Default display preference for recipe amounts"
    },
    {
      "key": "COMMENT_PREF_DEFAULT",
      "label": "Default Comment Setting",
      "default": "1",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Disabled", "value": "0" },
        { "label": "Enabled", "value": "1" }
      ],
      "description": "Default setting for allowing comments on recipes"
    }
  ],
  "ports": [
    {
      "container_port": 8080,
      "default_host_port": 8087,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
