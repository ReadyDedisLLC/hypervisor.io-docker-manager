{
  "name": "Dozzle",
  "slug": "dozzle",
  "description": "Lightweight real-time Docker log viewer with a clean web interface. No log storage — live monitoring only.",
  "icon": "icon.png",
  "category": "monitoring",
  "version": "latest",
  "website": "https://dozzle.dev",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 64,
  "min_storage_gb": 1,
  "env": [
    {
      "key": "DOZZLE_USERNAME",
      "label": "Admin Username",
      "default": "admin",
      "required": false,
      "type": "text",
      "description": "Username for basic authentication (leave empty to disable auth)"
    },
    {
      "key": "DOZZLE_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": false,
      "type": "password",
      "generate": true,
      "description": "Password for basic authentication (leave empty to disable auth)"
    }
  ],
  "ports": [
    {
      "container_port": 8080,
      "default_host_port": 8080,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
