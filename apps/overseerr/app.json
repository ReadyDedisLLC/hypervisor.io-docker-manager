{
  "name": "Overseerr",
  "slug": "overseerr",
  "description": "Media request and discovery tool for Plex, allowing users to easily request movies and TV shows.",
  "icon": "icon.png",
  "category": "media",
  "version": "latest",
  "website": "https://overseerr.dev",
  "docs_url": "https://docs.overseerr.dev/",
  "supported_distros": ["ubuntu-22.04","ubuntu-24.04","debian-12","rocky-9","almalinux-9"],
  "min_ram_mb": 512,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "TZ",
      "label": "Timezone",
      "default": "UTC",
      "required": false,
      "type": "text",
      "description": "Container timezone (e.g. America/New_York, Europe/London)"
    },
    {
      "key": "PUID",
      "label": "User ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "UID for the process inside the container (LinuxServer.io convention)"
    },
    {
      "key": "PGID",
      "label": "Group ID",
      "default": "1000",
      "required": false,
      "type": "number",
      "description": "GID for the process inside the container (LinuxServer.io convention)"
    },
    {
      "key": "LOG_LEVEL",
      "label": "Log Level",
      "default": "info",
      "required": false,
      "type": "select",
      "options": ["debug", "info", "warn", "error"],
      "description": "Application log verbosity level"
    }
  ],
  "ports": [
    {
      "container_port": 5055,
      "default_host_port": 5056,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
