{
  "name": "AFFiNE",
  "slug": "affine",
  "description": "Knowledge base and workspace — a self-hosted Notion alternative with docs, whiteboards, and databases.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "stable",
  "website": "https://affine.pro",
  "docs_url": "https://docs.affine.pro/docs/self-host-affine",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 2048,
  "min_storage_gb": 10,
  "env": [
    {
      "key": "AFFINE_ADMIN_EMAIL",
      "label": "Admin Email",
      "default": "admin@example.com",
      "required": false,
      "type": "text",
      "description": "Admin email address for the AFFiNE instance"
    },
    {
      "key": "AFFINE_ADMIN_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Admin password for the AFFiNE instance"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "label": "PostgreSQL Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "AFFINE_SERVER_HOST",
      "label": "Server Host",
      "default": "0.0.0.0",
      "required": false,
      "type": "text",
      "description": "Host address the AFFiNE server listens on"
    },
    {
      "key": "AFFINE_SERVER_HTTPS",
      "label": "Enable HTTPS",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Whether the server is behind an HTTPS reverse proxy"
    },
    {
      "key": "MAILER_HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails (e.g. smtp.gmail.com)"
    },
    {
      "key": "MAILER_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port"
    },
    {
      "key": "MAILER_USER",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "MAILER_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "MAILER_SENDER",
      "label": "Email Sender Address",
      "default": "",
      "required": false,
      "type": "text",
      "description": "From address for outgoing emails (e.g. noreply@example.com)"
    }
  ],
  "ports": [
    {
      "container_port": 3010,
      "default_host_port": 3010,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
