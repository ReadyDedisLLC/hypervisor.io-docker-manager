{
  "name": "Text Generation WebUI",
  "slug": "text-generation-webui",
  "description": "Oobabooga web interface for running large language models with support for multiple backends and model formats.",
  "icon": "icon.png",
  "category": "ai",
  "version": "latest",
  "website": "https://github.com/oobabooga/text-generation-webui",
  "docs_url": "https://github.com/oobabooga/text-generation-webui/wiki",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 8192,
  "min_storage_gb": 30,
  "env": [
    {
      "key": "EXTRA_LAUNCH_ARGS",
      "label": "Extra Launch Arguments",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Additional command-line arguments passed to the WebUI (e.g. --api --listen)"
    }
  ],
  "ports": [
    {
      "container_port": 7860,
      "default_host_port": 7860,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    },
    {
      "container_port": 5000,
      "default_host_port": 5000,
      "protocol": "tcp",
      "label": "API",
      "configurable": true
    }
  ]
}
