{
  "name": "SonarQube",
  "slug": "sonarqube",
  "description": "Self-hosted code quality and security analysis platform for continuous inspection of code.",
  "icon": "icon.png",
  "category": "development",
  "version": "community",
  "website": "https://sonarqube.org",
  "docs_url": "https://docs.sonarsource.com/sonarqube/latest/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 4096,
  "min_storage_gb": 20,
  "env": [
    {
      "key": "SONAR_JDBC_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "SONAR_WEB_JAVAADDITIONALOPTS",
      "label": "Web Java Options",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Additional Java options for the web server process (e.g., -Xmx512m)"
    },
    {
      "key": "SONAR_CE_JAVAADDITIONALOPTS",
      "label": "Compute Engine Java Options",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Additional Java options for the Compute Engine process"
    },
    {
      "key": "SONAR_SEARCH_JAVAADDITIONALOPTS",
      "label": "Search Java Options",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Additional Java options for the Elasticsearch process"
    }
  ],
  "ports": [
    {
      "container_port": 9000,
      "default_host_port": 9000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
