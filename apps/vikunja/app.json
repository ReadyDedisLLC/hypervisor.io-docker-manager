{
  "name": "Vikunja",
  "slug": "vikunja",
  "description": "Open-source task and project management tool with kanban boards, calendars, and team collaboration.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://vikunja.io",
  "docs_url": "https://vikunja.io/docs/",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-11",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9"
  ],
  "min_ram_mb": 256,
  "min_storage_gb": 2,
  "env": [
    {
      "key": "VIKUNJA_SERVICE_JWTSECRET",
      "label": "JWT Secret",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for JWT token signing"
    },
    {
      "key": "VIKUNJA_SERVICE_FRONTENDURL",
      "label": "Frontend URL",
      "default": "http://localhost:3456",
      "required": false,
      "type": "text",
      "description": "Full URL used to access Vikunja from a browser (e.g., https://tasks.example.com)"
    },
    {
      "key": "VIKUNJA_SERVICE_ENABLEREGISTRATION",
      "label": "Enable Registration",
      "default": "true",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Allow new users to register accounts"
    },
    {
      "key": "VIKUNJA_MAILER_ENABLED",
      "label": "Enable Email",
      "default": "false",
      "required": false,
      "type": "select",
      "options": [
        { "label": "Yes", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "description": "Enable email notifications and password resets"
    },
    {
      "key": "VIKUNJA_MAILER_HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails"
    },
    {
      "key": "VIKUNJA_MAILER_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port (587 for STARTTLS, 465 for SSL)"
    },
    {
      "key": "VIKUNJA_MAILER_USERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "VIKUNJA_MAILER_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    }
  ],
  "ports": [
    {
      "container_port": 3456,
      "default_host_port": 3456,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
