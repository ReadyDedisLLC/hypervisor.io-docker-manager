{
  "name": "Dify",
  "slug": "dify",
  "description": "LLM app development platform for building AI-powered chatbots, agents, and workflow automations.",
  "icon": "icon.png",
  "category": "ai",
  "version": "latest",
  "website": "https://dify.ai",
  "docs_url": "https://docs.dify.ai",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 4096,
  "min_storage_gb": 20,
  "env": [
    {
      "key": "SECRET_KEY",
      "label": "Secret Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for session and data encryption"
    },
    {
      "key": "DB_USERNAME",
      "label": "Database Username",
      "default": "postgres",
      "required": true,
      "type": "text",
      "description": "Username for the PostgreSQL database"
    },
    {
      "key": "DB_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "REDIS_PASSWORD",
      "label": "Redis Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the Redis instance"
    },
    {
      "key": "LOG_LEVEL",
      "label": "Log Level",
      "default": "INFO",
      "required": false,
      "type": "select",
      "options": ["DEBUG", "INFO", "WARNING", "ERROR"],
      "description": "Application log verbosity level"
    },
    {
      "key": "STORAGE_TYPE",
      "label": "Storage Type",
      "default": "local",
      "required": false,
      "type": "select",
      "options": ["local", "s3", "azure-blob"],
      "description": "File storage backend type"
    },
    {
      "key": "OPENAI_API_KEY",
      "label": "OpenAI API Key",
      "default": "",
      "required": false,
      "type": "password",
      "description": "API key for OpenAI models (can also be added via the web UI)"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
