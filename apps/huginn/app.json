{
  "name": "Huginn",
  "slug": "huginn",
  "description": "Programmable automation agents that monitor the web and act on your behalf, performing automated tasks triggered by events.",
  "icon": "icon.png",
  "category": "automation",
  "version": "latest",
  "website": "https://github.com/huginn/huginn",
  "docs_url": "https://github.com/huginn/huginn/wiki",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 1024,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "HUGINN_SEED_USERNAME",
      "label": "Admin Username",
      "default": "admin",
      "required": true,
      "type": "text",
      "description": "Username for the initial admin account"
    },
    {
      "key": "HUGINN_SEED_PASSWORD",
      "label": "Admin Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the initial admin account"
    },
    {
      "key": "APP_SECRET_TOKEN",
      "label": "App Secret Token",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret token used for Rails session encryption and signing"
    },
    {
      "key": "DOMAIN",
      "label": "Domain",
      "default": "localhost",
      "required": false,
      "type": "text",
      "description": "Domain name where Huginn is accessible"
    },
    {
      "key": "INVITATION_CODE",
      "label": "Invitation Code",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Code required for new users to sign up (leave empty to disable signups)"
    },
    {
      "key": "SMTP_DOMAIN",
      "label": "SMTP Domain",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Domain for outgoing email (e.g. your-domain.com)"
    },
    {
      "key": "SMTP_USER_NAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "SMTP_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "SMTP_SERVER",
      "label": "SMTP Server",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname (e.g. smtp.gmail.com)"
    },
    {
      "key": "SMTP_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port (587 for TLS, 465 for SSL)"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3004,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
