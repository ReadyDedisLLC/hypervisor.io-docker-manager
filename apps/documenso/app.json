{
  "name": "Documenso",
  "slug": "documenso",
  "description": "Open-source DocuSign alternative for digital document signing with a beautiful, modern interface.",
  "icon": "icon.png",
  "category": "productivity",
  "version": "latest",
  "website": "https://documenso.com",
  "docs_url": "https://documenso.com/docs",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 512,
  "min_storage_gb": 5,
  "env": [
    {
      "key": "NEXTAUTH_SECRET",
      "label": "Auth Secret",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secret key for NextAuth session encryption"
    },
    {
      "key": "NEXTAUTH_URL",
      "label": "Application URL",
      "default": "http://localhost:3000",
      "required": true,
      "type": "text",
      "description": "Public URL of your Documenso instance"
    },
    {
      "key": "NEXT_PRIVATE_ENCRYPTION_KEY",
      "label": "Encryption Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Key used to encrypt sensitive document data (min 32 chars)"
    },
    {
      "key": "NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY",
      "label": "Secondary Encryption Key",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Secondary key used to encrypt sensitive document data (min 32 chars)"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "label": "Database Password",
      "default": "",
      "required": true,
      "type": "password",
      "generate": true,
      "description": "Password for the PostgreSQL database"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_HOST",
      "label": "SMTP Host",
      "default": "",
      "required": false,
      "type": "text",
      "description": "SMTP server hostname for sending emails (e.g., smtp.gmail.com)"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_PORT",
      "label": "SMTP Port",
      "default": "587",
      "required": false,
      "type": "number",
      "description": "SMTP server port (587 for TLS, 465 for SSL)"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_USERNAME",
      "label": "SMTP Username",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Username for SMTP authentication"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_PASSWORD",
      "label": "SMTP Password",
      "default": "",
      "required": false,
      "type": "password",
      "description": "Password for SMTP authentication"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_FROM_ADDRESS",
      "label": "SMTP From Address",
      "default": "",
      "required": false,
      "type": "text",
      "description": "Email address used as the sender for outgoing emails"
    },
    {
      "key": "NEXT_PRIVATE_SMTP_FROM_NAME",
      "label": "SMTP From Name",
      "default": "Documenso",
      "required": false,
      "type": "text",
      "description": "Display name used as the sender for outgoing emails"
    }
  ],
  "ports": [
    {
      "container_port": 3000,
      "default_host_port": 3000,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
