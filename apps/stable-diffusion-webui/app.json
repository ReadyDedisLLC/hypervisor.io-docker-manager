{
  "name": "Stable Diffusion WebUI",
  "slug": "stable-diffusion-webui",
  "description": "AUTOMATIC1111 Stable Diffusion web interface for AI image generation with extensive model and extension support.",
  "icon": "icon.png",
  "category": "ai",
  "version": "latest",
  "website": "https://github.com/AUTOMATIC1111/stable-diffusion-webui",
  "docs_url": "https://github.com/AUTOMATIC1111/stable-diffusion-webui/wiki",
  "supported_distros": [
    "ubuntu-22.04",
    "ubuntu-24.04",
    "debian-12",
    "rocky-9",
    "almalinux-9"
  ],
  "min_ram_mb": 8192,
  "min_storage_gb": 30,
  "env": [
    {
      "key": "COMMANDLINE_ARGS",
      "label": "Command Line Args",
      "default": "--listen",
      "required": false,
      "type": "text",
      "description": "Additional command line arguments (e.g., --api --xformers --medvram)"
    }
  ],
  "ports": [
    {
      "container_port": 7860,
      "default_host_port": 7860,
      "protocol": "tcp",
      "label": "Web UI",
      "configurable": true
    }
  ]
}
